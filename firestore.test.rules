rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == "admin";
    }

    function isTrainer() {
      return signedIn() && request.auth.token.role == "trainer";
    }

    function ownsProfile(userId) {
      return signedIn()
        && (request.auth.uid == userId || request.auth.uid == resource.data.uid);
    }

    match /users/{userId} {
      allow get: if ownsProfile(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && !("password" in request.resource.data);

      allow update: if !("password" in request.resource.data)
        && (isAdmin()
          || (ownsProfile(userId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role));

      allow delete: if isAdmin();
    }

    match /trainings/{trainingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.created_by_user_id == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.created_by_user_id == request.auth.uid);
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTrainer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
