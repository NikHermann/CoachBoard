rules_version = '2';

// Variante B: restriktiver Zielzustand.
// Rollen stammen ausschließlich aus serverseitig gesetzten Custom Claims.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.get("role", "") == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isTrainer() {
      return hasRole("trainer");
    }

    function canCreateTraining() {
      return isTrainer() || isAdmin();
    }

    function authProfileId() {
      return signedIn()
        ? request.auth.token.get("profile_id", request.auth.uid)
        : "";
    }

    function hasNoStoredPassword(data) {
      return !("password" in data);
    }

    function ownsProfile(userId) {
      return signedIn()
        && "uid" in resource.data
        && request.auth.uid == resource.data.uid;
    }

    function validEditableProfileFields() {
      return request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 80
        && request.resource.data.club is string
        && request.resource.data.club.size() > 0
        && request.resource.data.club.size() <= 120;
    }

    function validOptionalAvatar(data) {
      return !data.keys().hasAny(["avatarData"])
        || (data.avatarData is string
          && data.avatarData.size() > 0
          && data.avatarData.size() <= 40983
          && data.avatarData.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$'));
    }

    function isClaimlessSelfRegistration(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.auth.token.email is string
        && request.auth.token.get("role", "") == ""
        && request.auth.token.get("profile_id", "") == "";
    }

    function validSelfRegisteredPlayer(userId) {
      return isClaimlessSelfRegistration(userId)
        && request.resource.data.keys().hasOnly([
          "uid", "email", "username", "club", "role"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "spieler"
        && hasNoStoredPassword(request.resource.data)
        && validEditableProfileFields()
        && validOptionalAvatar(request.resource.data);
    }

    function validOwnProfileUpdate(userId) {
      return ownsProfile(userId)
        && hasNoStoredPassword(resource.data)
        && hasNoStoredPassword(request.resource.data)
        && validEditableProfileFields()
        && validOptionalAvatar(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username", "club", "avatarData"
        ]);
    }

    match /users/{userId} {
      // Legacy-Dokumente mit Passwortfeld bleiben auch für den Besitzer gesperrt.
      allow get: if (isClaimlessSelfRegistration(userId)
          && !exists(/databases/$(database)/documents/users/$(userId)))
        || (hasNoStoredPassword(resource.data) && ownsProfile(userId));
      // Collection-Queries können Felder nicht redigieren. Bis alle Legacy-
      // Passwortfelder entfernt sind, erfolgt Admin-Auflistung nur serverseitig.
      allow list: if false;

      // Nur das eigene, streng validierte Spielerprofil darf erstmalig
      // clientseitig entstehen. Rollenänderungen bleiben serverseitig.
      allow create: if validSelfRegisteredPlayer(userId);
      allow update: if validOwnProfileUpdate(userId);
      allow delete: if false;
    }

    match /trainings/{trainingId} {
      allow read: if signedIn();
      allow create: if canCreateTraining()
        && request.resource.data.created_by_auth_uid == request.auth.uid
        && request.resource.data.created_by_user_id == authProfileId()
        && (!request.resource.data.get("is_template", false) || isAdmin());
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "created_by_auth_uid", "created_by_user_id"
        ])
        && (isAdmin()
        || (isTrainer()
          && !resource.data.get("is_template", false)
          && !request.resource.data.get("is_template", false)
          && resource.data.created_by_auth_uid == request.auth.uid
        )
        || (isTrainer()
          && !resource.data.get("is_template", false)
          && !request.resource.data.get("is_template", false)
          && !("created_by_auth_uid" in resource.data)
          && !("created_by_auth_uid" in request.resource.data)
          && resource.data.created_by_user_id == authProfileId()
        ));
      allow delete: if isAdmin()
        || (isTrainer()
          && !resource.data.get("is_template", false)
          && resource.data.created_by_auth_uid == request.auth.uid)
        || (isTrainer()
          && !resource.data.get("is_template", false)
          && !("created_by_auth_uid" in resource.data)
          && resource.data.created_by_user_id == authProfileId());
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTrainer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
